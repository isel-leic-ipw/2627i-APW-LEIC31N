<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Shopping List - Home</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>body{padding-top:60px}</style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary fixed-top">
    <div class="container">
      <a class="navbar-brand" href="/">Shopping List</a>
      <div class="collapse navbar-collapse" id="nav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
          <li class="nav-item"><a class="nav-link" href="/lists">My Lists</a></li>
          {{#if user}}
          <li class="nav-item">
            <form method="post" action="/logout" style="display:inline-block">
              <button class="nav-link btn btn-outline-light btn-sm ms-2" style="border:none">Logout</button>
            </form>
          </li>
          {{/if}}
        </ul>
      </div>
    </div>
  </nav>

  <main class="container my-5">
    <div class="row">
      <div class="col-lg-8 mx-auto">
        <h1 class="mb-4">Shopping List Management System</h1>

        {{#if user}}
        <div class="alert alert-info">Logged in as: <strong>{{user.username}}</strong></div>
        {{/if}}

        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title">Welcome</h5>
            <p class="card-text">This app lets you create and manage shopping lists. Authentication is via HTTP Basic Auth.</p>
          </div>
        </div>

        <div class="card mb-4">
          <div class="card-header bg-success text-white">Test Users</div>
          <div class="card-body">
            <table class="table table-sm">
              <thead><tr><th>Username</th><th>Password</th></tr></thead>
              <tbody>
                <tr><td>alice</td><td><code>password123</code></td></tr>
                <tr><td>bob</td><td><code>secret456</code></td></tr>
                <tr><td>charlie</td><td><code>test789</code></td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="list-group">
          <a href="/lists" class="list-group-item list-group-item-action">View My Lists (requires auth)</a>
        </div>
      </div>
    </div>
  </main>

  <footer class="text-center py-4">
    <div class="container">&copy; 2025 PRODIGI Shopping List</div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
