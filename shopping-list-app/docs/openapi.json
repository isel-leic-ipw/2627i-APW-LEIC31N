{
  "openapi": "3.0.3",
  "info": {
    "title": "Shopping List App",
    "version": "1.0.0",
    "description": "JSON API for managing personal shopping lists and their items."
  },
  "security": [],
  "servers": [
    {
      "url": "/",
      "description": "Current application host"
    }
  ],
  "tags": [
    {
      "name": "Shopping List API",
      "description": "Authenticated JSON API for shopping lists and items"
    }
  ],
  "paths": {
    "/api/lists": {
      "get": {
        "tags": ["Shopping List API"],
        "operationId": "apiGetLists",
        "summary": "Get the signed-in user's shopping lists",
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {"$ref": "#/components/responses/ApiLists"},
          "401": {"$ref": "#/components/responses/ApiAuthenticationError"},
          "500": {"$ref": "#/components/responses/ApiError"}
        }
      },
      "post": {
        "tags": ["Shopping List API"],
        "operationId": "apiCreateList",
        "summary": "Create a shopping list",
        "security": [{"bearerAuth": []}],
        "requestBody": {"$ref": "#/components/requestBodies/JsonList"},
        "responses": {
          "201": {"$ref": "#/components/responses/ApiListResult"},
          "400": {"$ref": "#/components/responses/ApiError"},
          "401": {"$ref": "#/components/responses/ApiAuthenticationError"}
        }
      }
    },
    "/api/lists/{id}": {
      "parameters": [{"$ref": "#/components/parameters/ListId"}],
      "get": {
        "tags": ["Shopping List API"],
        "operationId": "apiGetList",
        "summary": "Get a shopping list and its items",
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {"$ref": "#/components/responses/ApiList"},
          "401": {"$ref": "#/components/responses/ApiAuthenticationError"},
          "404": {"$ref": "#/components/responses/ApiError"}
        }
      },
      "put": {
        "tags": ["Shopping List API"],
        "operationId": "apiUpdateList",
        "summary": "Rename a shopping list",
        "security": [{"bearerAuth": []}],
        "requestBody": {"$ref": "#/components/requestBodies/JsonList"},
        "responses": {
          "200": {"$ref": "#/components/responses/ApiListResult"},
          "400": {"$ref": "#/components/responses/ApiError"},
          "401": {"$ref": "#/components/responses/ApiAuthenticationError"},
          "404": {"$ref": "#/components/responses/ApiError"}
        }
      },
      "delete": {
        "tags": ["Shopping List API"],
        "operationId": "apiDeleteList",
        "summary": "Delete a shopping list",
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {"$ref": "#/components/responses/ApiMessage"},
          "401": {"$ref": "#/components/responses/ApiAuthenticationError"},
          "404": {"$ref": "#/components/responses/ApiError"}
        }
      }
    },
    "/api/lists/{id}/items": {
      "parameters": [{"$ref": "#/components/parameters/ListId"}],
      "post": {
        "tags": ["Shopping List API"],
        "operationId": "apiAddItem",
        "summary": "Add an item to a shopping list",
        "security": [{"bearerAuth": []}],
        "requestBody": {"$ref": "#/components/requestBodies/JsonItem"},
        "responses": {
          "201": {"$ref": "#/components/responses/ApiItemResult"},
          "400": {"$ref": "#/components/responses/ApiError"},
          "401": {"$ref": "#/components/responses/ApiAuthenticationError"},
          "404": {"$ref": "#/components/responses/ApiError"}
        }
      }
    },
    "/api/lists/{id}/items/{itemId}/toggle": {
      "parameters": [
        {"$ref": "#/components/parameters/ListId"},
        {"$ref": "#/components/parameters/ItemId"}
      ],
      "post": {
        "tags": ["Shopping List API"],
        "operationId": "apiToggleItem",
        "summary": "Toggle an item's bought status",
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {"$ref": "#/components/responses/ApiItemResult"},
          "401": {"$ref": "#/components/responses/ApiAuthenticationError"},
          "404": {"$ref": "#/components/responses/ApiError"}
        }
      }
    },
    "/api/lists/{id}/items/{itemId}": {
      "parameters": [
        {"$ref": "#/components/parameters/ListId"},
        {"$ref": "#/components/parameters/ItemId"}
      ],
      "delete": {
        "tags": ["Shopping List API"],
        "operationId": "apiDeleteItem",
        "summary": "Remove an item from a shopping list",
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {"$ref": "#/components/responses/ApiMessage"},
          "401": {"$ref": "#/components/responses/ApiAuthenticationError"},
          "404": {"$ref": "#/components/responses/ApiError"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ShoppingList": {
        "type": "object",
        "required": ["id", "name", "items"],
        "properties": {
          "id": {"type": "integer"},
          "name": {"type": "string"},
          "items": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/ShoppingItem"}
          }
        }
      },
      "ShoppingItem": {
        "type": "object",
        "required": ["id", "name", "quantity", "bought"],
        "properties": {
          "id": {"type": "integer"},
          "name": {"type": "string"},
          "quantity": {"type": "integer", "minimum": 1},
          "bought": {"type": "boolean"}
        }
      },
      "ShoppingListResult": {
        "type": "object",
        "required": ["list"],
        "properties": {"list": {"$ref": "#/components/schemas/ShoppingList"}}
      },
      "ShoppingItemResult": {
        "type": "object",
        "required": ["item"],
        "properties": {"item": {"$ref": "#/components/schemas/ShoppingItem"}}
      },
      "ApiError": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": {"type": "string"},
          "description": {"type": "string"}
        }
      },
      "ApiMessage": {
        "type": "object",
        "required": ["status"],
        "properties": {"status": {"type": "string"}}
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API token",
        "description": "Use a demo API token documented in the project README."
      }
    },
    "parameters": {
      "ListId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        },
        "description": "Shopping-list identifier"
      },
      "ItemId": {
        "name": "itemId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        },
        "description": "Item identifier within the shopping list"
      }
    },
    "requestBodies": {
      "JsonList": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["name"],
              "properties": {"name": {"type": "string", "minLength": 1}}
            }
          }
        }
      },
      "JsonItem": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["name", "quantity"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "quantity": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    },
    "responses": {
      "ApiLists": {
        "description": "The user's shopping lists",
        "content": {
          "application/json": {
            "schema": {
              "type": "array",
              "items": {"$ref": "#/components/schemas/ShoppingList"}
            }
          }
        }
      },
      "ApiList": {
        "description": "A shopping list",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/ShoppingList"}
          }
        }
      },
      "ApiListResult": {
        "description": "The created or updated shopping list",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/ShoppingListResult"}
          }
        }
      },
      "ApiItemResult": {
        "description": "The created or updated shopping-list item",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/ShoppingItemResult"}
          }
        }
      },
      "ApiMessage": {
        "description": "Operation result",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/ApiMessage"}
          }
        }
      },
      "ApiError": {
        "description": "Request failed",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/ApiError"}
          }
        }
      },
      "ApiAuthenticationError": {
        "description": "Missing or invalid Bearer token.",
        "headers": {
          "WWW-Authenticate": {"schema": {"type": "string"}}
        },
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/ApiError"}
          }
        }
      }
    }
  }
}